# =============================================================================
# Quivo environment template — copy to `.env.local` and fill in real values.
# Every key is grouped by the subsystem that reads it. `*_PUBLIC_*` keys are
# inlined into the client bundle; everything else stays server-side.
# =============================================================================

# ─── Core: Supabase ──────────────────────────────────────────────────────────
# Supabase project URL + anon key from Project Settings → API. The anon key
# is safe to expose; RLS gates every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key, used by /lib/supabase/admin.ts for ops that must bypass
# RLS (cron dispatch, domain-event writes, sitemap fan-out). NEVER expose to
# the browser. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Core: deployment URL ────────────────────────────────────────────────────
# Used by getSiteUrl() to build absolute links in emails, redirects, OG meta.
# In production set this to your canonical https URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cron: required to expose /api/cron/[job] ────────────────────────────────
# Long random string (≥ 32 chars). The cron dispatcher refuses requests
# without a matching x-cron-secret header (or Authorization: Bearer <secret>
# for Vercel cron). Generate with `openssl rand -hex 32`.
CRON_SECRET=

# ─── Email: Resend (Phase 0 shell, Phase 2 dispatcher) ───────────────────────
# Sign up at resend.com and create an API key. Without this, every
# sendEmail() call short-circuits to a structured-log no-op.
RESEND_API_KEY=
# Default From header. Overridden per template (KYC uses KYC_EMAIL_FROM if set).
EMAIL_FROM="Quivo <onboarding@quivo.app>"
KYC_EMAIL_FROM="Quivo Compliance <kyc@quivo.app>"

# ─── Rate limit: Upstash Redis (lib/rate-limit.ts) ───────────────────────────
# Optional in dev (the limiter falls back to an in-memory bucket). In
# production, set both to enable the proper distributed rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web push (Phase 4.8) ────────────────────────────────────────────────────
# Generate keys with: `npx web-push generate-vapid-keys --json`
# Without these, sendPushToUser() no-ops and the prefs page renders an
# "operator hasn't set NEXT_PUBLIC_VAPID_PUBLIC_KEY" hint.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@quivo.app

# ─── Sentry (Phase 0 scaffolding) ────────────────────────────────────────────
# Activated when @sentry/nextjs is installed. Browser SDK reads
# NEXT_PUBLIC_SENTRY_DSN; server SDK reads SENTRY_DSN (falls back to the
# public DSN if absent).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map uploads via the Sentry build plugin (optional).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Image moderation (Phase 4 — optional) ───────────────────────────────────
# Layer a SaaS image moderator on top of MIME + size validation. Leave empty
# to skip the moderator and rely on the built-in checks only.
IMAGE_MODERATION_PROVIDER=
IMAGE_MODERATION_URL=
IMAGE_MODERATION_KEY=

# ─── Logger (Phase 0) ────────────────────────────────────────────────────────
# Optional. One of debug | info | warn | error | fatal. Defaults to "info"
# in production and "debug" in development.
# LOG_LEVEL=debug

# ─── Vercel-supplied (read by lib/sentry.ts + /api/health) ────────────────────
# Vercel sets these automatically on deploys; you typically do NOT add them
# to .env.local. Listed here so the operator knows where the "version"
# column in /api/health and the Sentry release tag come from.
# NEXT_PUBLIC_VERCEL_ENV=preview            # or production / development
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=        # short commit sha
# VERCEL_GIT_COMMIT_SHA=                    # same value, server-only

# ─── Payments (existing, set per-shop in the dashboard, not here) ────────────
# eSewa / Khalti credentials live in the `shop_payment_configs` table per
# shop, encrypted at rest. Operators don't need to add them to .env.
